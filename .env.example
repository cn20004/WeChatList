PORT=3000
WECHAT_REQUEST_TIMEOUT_MS=30000
WECHAT_USER_AGENT=Mozilla/5.0

# Authenticated mp.weixin.qq.com session credentials.
# Use only credentials from your own account/session. Never commit real values.
WECHAT_COOKIE=
WECHAT_TOKEN=

# Conservative defaults for private backend requests.
WECHAT_REQUEST_DELAY_MS=500
WECHAT_RATE_LIMIT_COOLDOWN_MS=20000
WECHAT_RATE_LIMIT_RETRIES=2

# Required only for PDF/JPG full-page rendering.
# Example on Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Edge can also be used.
CHROME_EXECUTABLE_PATH=
